<?xml version="1.0"?>
<launch>
  <!-- PCAP replay launch file for Mako G-319C camera -->
  <arg name="name" default="camera" doc="The name of the camera"/>
  <arg name="frame_id" default="$(var name)" doc="The frame id of the camera"/>
  <arg name="pcap_file" default="" doc="Path to the PCAP file to replay"/>
  <arg name="enable_pcap" default="true" doc="Enable PCAP replay mode"/>
  <arg name="camera_info_url" default="file://$(find-pkg-share avt_vimba_camera)/calibrations/calibration_example.yaml"/>
  <arg name="image_proc" default="false" doc="Launch image_proc with driver"/>

  <!-- Camera parameters (not used in PCAP mode but included for compatibility) -->
  <arg name="params_file" default="$(find-pkg-share avt_vimba_camera)/config/Mako_G-319.yaml"/>

  <node pkg="avt_vimba_camera" exec="mono_camera_exec" name="$(var name)" output="screen">
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="ip" value=""/>
    <param name="guid" value=""/>
    <param name="use_measurement_time" value="false"/>
    <param name="ptp_offset" value="0"/>
    <param name="camera_info_url" value="$(var camera_info_url)"/>
    <param name="publish_compressed" value="true"/>
    <param name="enable_pcap" value="$(var enable_pcap)"/>
    <param name="pcap_file" value="$(var pcap_file)"/>
    <param from="$(var params_file)"/>
  </node>

  <node if="$(var image_proc)" pkg="image_proc" exec="image_proc" name="image_proc" output="screen" ns="$(var name)">
    <remap from="image" to="image"/>
  </node>
</launch>
